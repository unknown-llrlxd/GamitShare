{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "controller/*.php": {
      "runtime": "vercel-php@0.7.1"
    },
    "test_db.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    {
      "src": "^/$",
      "dest": "/views/auth/login.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}