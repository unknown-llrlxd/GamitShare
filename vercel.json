{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    {
      "src": "^/$",
      "dest": "/views/auth/login.html"
    },
    {
      "src": "^/assets/(.*)$",
      "dest": "/views/assets/$1"
    },
    {
      "src": "^/controller/(.+\\.php)$",
      "dest": "/api/index.php"
    },
    {
      "src": "^/test_db\\.php$",
      "dest": "/api/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}